# Arquivos locais de ambiente/segredos — nunca enviar ao GitHub
.env
.env.*
!.env.example

# Chaves privadas de contas de serviço / Firebase Admin SDK
*firebase-adminsdk*.json
*firebase-admin*.json
firebase-admin-key.json
firebase-service-account*.json
serviceAccountKey.json
service-account*.json

# Arquivos de chave/certificado privado
*.pem
*.key
*.p12

# Pastas locais de credenciais
/secrets/
/credentials/

# A configuração pública de cliente do Firebase permanece no index.html.
# Ela não é uma chave privada; chaves Admin devem ficar fora do HTML.
